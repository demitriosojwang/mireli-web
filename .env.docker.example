# ---------------------------------------------------------------------------
# Mireli container configuration — copy to `.env.docker` and edit.
#
#   cp .env.docker.example .env.docker
#
# `.env.docker` is git-ignored: it holds real secrets. Every value below has a
# The example supplies local defaults except values marked REQUIRED.
# ---------------------------------------------------------------------------

# --- database ---------------------------------------------------------------
# The entrypoint constructs and safely URL-encodes the private DATABASE_URL.
POSTGRES_USER=mireli
POSTGRES_PASSWORD=change_me_alphanumeric
POSTGRES_DB=mireli
MIRELI_DATABASE_MODE=embedded

# --- application ------------------------------------------------------------
# REQUIRED. Signs passenger/admin session cookies. 32+ characters.
# Generate one per deployment:
#   pwsh -Command "[BitConverter]::ToString((1..48|%{Get-Random -Max 256})) -replace '-', ''"
SESSION_SECRET=replace_with_48_random_hex_characters_minimum

# Optional only for this explicitly unsafe local demo: if omitted, passenger
# ID data uses a key derived from SESSION_SECRET. Strict production requires a
# separate random 32-byte key (64 hex characters) injected outside this file.
# PASSENGER_PII_ENCRYPTION_KEY=

# Public origin browsers use to reach the app. A demo deployment derives it
# from each request, but keep it accurate so the CSRF boundary matches.
MIRELI_PUBLIC_ORIGIN=http://localhost:3000
MIRELI_PORT=3000
TZ=Africa/Nairobi

# Apply prisma/migrations on every container start (idempotent, never seeds).
MIRELI_APPLY_DATABASE_MIGRATIONS=true

# First-run bootstrap. A brand new database has no operations-settings row and
# the admin console needs one before it can be signed in to, so this creates
# that single row with the documented schema defaults. It never seeds bookings,
# drivers, timetable or money, and never modifies an existing row.
MIRELI_BOOTSTRAP_PLATFORM_CONFIG=true

# --- prototype boundary -----------------------------------------------------
# MIRELI_DEMO_MODE unlocks the local dev server on its own. This production
# build container needs the second, explicit acknowledgement below.
#   true  -> prototype admin/passenger sign-in, simulated M-Pesa, local
#            encrypted document storage. Never for real passengers.
#   false -> strict production: sign-in and payments stay disabled until real
#            Daraja/Brevo/S3 credentials and verified authentication exist.
MIRELI_DEMO_MODE=true
MIRELI_ALLOW_UNSAFE_DEMO=true

# --- M-Pesa (optional; demo mode simulates payments without these) ----------
MPESA_MODE=mock
MPESA_ENVIRONMENT=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_BASE_URL=https://your.domain

# --- driver platform (optional; required to open production intake) ---------
# DRIVER_AUTH_SECRET=
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=
# AWS_REGION=
# DRIVER_DOCUMENT_BUCKET=
# DRIVER_SCAN_COMMAND=
# DRIVER_COMPLIANCE_REVIEWERS=
# DRIVER_SUPPORT_REVIEWERS=
# DRIVER_FINANCE_REVIEWERS=
# DRIVER_POLICY_VERSION=
# DRIVER_PRIVACY_URL=
# DRIVER_TERMS_URL=

# --- email (optional) -------------------------------------------------------
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
