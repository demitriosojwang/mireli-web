# Example values only. Keep real credentials in the deployment secret store.
# Prisma ORM 6 with PostgreSQL TCP. This is not a live connection string.
DATABASE_URL="postgresql://mireli:replace_me@localhost:5432/mireli?schema=public"
# Generate a cryptographically random secret of at least 32 characters.
SESSION_SECRET=""
# Separate random 32-byte key (64 hex characters) for passenger ID/passport data.
# Required in strict production; never reuse SESSION_SECRET. Back up securely.
PASSENGER_PII_ENCRYPTION_KEY=""
MIRELI_DEMO_MODE="false"
MPESA_MODE="live"
MPESA_ENVIRONMENT="sandbox"
# Production OTP/authentication integration is still required. Demo login is local-only.
DRIVER_AUTH_SECRET=""
AT_USERNAME=""
AT_API_KEY=""
AT_SENDER_ID=""
AWS_REGION=""
DRIVER_DOCUMENT_BUCKET=""
# Absolute path to a configured ClamAV scanner; no shell commands here.
DRIVER_SCAN_COMMAND=""
DRIVER_COMPLIANCE_REVIEWERS=""
DRIVER_SUPPORT_REVIEWERS=""
DRIVER_FINANCE_REVIEWERS=""
DRIVER_POLICY_VERSION=""
DRIVER_PRIVACY_URL=""
DRIVER_TERMS_URL=""
VALHALLA_URL=""
VALHALLA_API_TOKEN=""
MPESA_LIVE_PAYOUTS_ENABLED="false"
MPESA_LIVE_REFUNDS_ENABLED="false"
MIRELI_PUBLIC_ORIGIN="https://mirelisgr.duckdns.org"
# One-time empty-database initialization only; leave false in normal deployments.
MIRELI_INITIALIZE_EMPTY_DATABASE="false"
MIRELI_APPLY_DATABASE_MIGRATIONS="false"
BREVO_API_KEY=""
# Sender approved in Brevo. Its API key stays on the backend only.
BREVO_SENDER_EMAIL=""
