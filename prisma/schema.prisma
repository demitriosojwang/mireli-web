generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── People ──────────────────────────────────────────────────────────────────

model Passenger {
  id          String   @id @default(cuid())
  phone       String   @unique
  name        String?
  email       String?
  // Primary-passenger profile — captured on the booking form; guests upgrade
  // into an account by re-submitting the exact same details.
  idType      String? // "id" | "passport"
  idNumber    String? // AES-256-GCM encrypted National ID or passport number; legacy plaintext until backfill
  nationality String?
  gender      String?
  createdAt   DateTime @default(now())
  bookings    Booking[]
  credits     Credit[]
}

// Drivers exist here as data the ADMIN manages (CRUD, M-Pesa number, allocation).
// There is no driver UI in Mi-Reli — the driver app is a separate build by a
// separate team; it would consume these same records via API.
model Driver {
  id          String         @id @default(cuid())
  name        String
  phone       String?        @unique
  email       String?        @unique
  emailVerifiedAt DateTime?
  mpesaNumber String
  plate       String
  cabType     String
  capacity    Int
  status      String         @default("active") // active | inactive | suspended
  rating      Float          @default(4.8)
  createdAt   DateTime       @default(now())
  trips       Trip[]
  payouts     PayoutRecord[]
  sessions    DriverSession[]
  application DriverApplication?
  supportCases DriverSupportCase[]
  tripProgress DriverTripProgress[]
  tripActions DriverTripAction[]
  payoutDestination DriverPayoutDestination?
}

// ─── Network ─────────────────────────────────────────────────────────────────

// The Madaraka Express services Mi-Reli synchronizes with (MTM = Mombasa
// Terminus, NTM = Nairobi Terminus). Feeder cabs are timed to these events:
//   · MBA_TO_NBO trains DEPART MTM  → TO_TERMINUS shuttles arrive there early
//   · NBO_TO_MBA trains ARRIVE MTM  → FROM_TERMINUS shuttles meet them
model Train {
  id            String  @id @default(cuid())
  name          String // Inter-County | Express | Night Train
  direction     String // MBA_TO_NBO | NBO_TO_MBA
  originCode    String // MTM | NTM
  destCode      String // MTM | NTM
  originTime    String // "HH:MM" departure at origin terminus
  destTime      String // "HH:MM" arrival at destination terminus
  destDayOffset Int     @default(0) // 1 when arrival is next calendar day (night train)
  serviceDays   Int[]   @default([0, 1, 2, 3, 4, 5, 6]) // ISO-independent JS weekdays: Sunday 0 through Saturday 6, at origin terminus
  active        Boolean @default(true)
  trips         Trip[]
}

model Route {
  id             String       @id @default(cuid())
  name           String
  durationMinutes Int
  charterPrice   Int // Legacy only; customer charter pricing uses assigned capacity and stage fare
  active         Boolean      @default(true)
  stages         RouteStage[]
  trips          Trip[]
  bookings       Booking[]
}

model RouteStage {
  id            String  @id @default(cuid())
  routeId       String
  route         Route   @relation(fields: [routeId], references: [id])
  name          String
  order         Int // 0 = Miritini Terminus (origin)
  lat           Float
  lng           Float
  fare          Int // per-seat fare from origin (KSh)
  homeSurcharge Int // door-pickup surcharge per seat (KSh) — passes to driver in full
}

// ─── Trips & bookings ────────────────────────────────────────────────────────

model Trip {
  id           String       @id @default(cuid())
  routeId      String
  route        Route        @relation(fields: [routeId], references: [id])
  driverId     String?
  driver       Driver?      @relation(fields: [driverId], references: [id])
  direction    String // FROM_TERMINUS | TO_TERMINUS
  departureAt  DateTime
  capacity     Int
  bookedSeats  Int          @default(0)
  status       String       @default("scheduled") // scheduled | locked | departed | completed | cancelled
  lockedAt     DateTime?
  lockReason   String? // seat_threshold | cutoff
  departedAt   DateTime?
  completedAt  DateTime?
  source       String       @default("schedule") // schedule | auto
  trainId      String?
  train        Train?       @relation(fields: [trainId], references: [id])
  bookings     Booking[]
  payouts      PayoutRecord[]
  createdAt    DateTime     @default(now())
  driverProgress DriverTripProgress[]
  @@index([driverId, status, departureAt])
}

model Booking {
  id            String    @id @default(cuid())
  code          String    @unique // MR-XXXXXX
  passengerId   String
  passenger     Passenger @relation(fields: [passengerId], references: [id])
  tripId        String?
  trip          Trip?     @relation(fields: [tripId], references: [id])
  routeId       String
  route         Route     @relation(fields: [routeId], references: [id])
  direction     String
  stageId       String?
  stageName     String?
  homePickup    Boolean   @default(false)
  homeAddress   String?
  seats         Int       @default(1)
  isCharter     Boolean   @default(false)
  fareAmount    Int // total charged: shared fare + surcharge + fee; charter fare + surcharge with fee embedded in platform share
  platformFeeAmount Int @default(0) // shared: KSh fee per booked passenger seat; charter: one fee recorded within Mireli's 10% share
  homeSurcharge Int // total home surcharge for this booking
  creditApplied Int // portion covered by travel credit (never cash)
  cashDue       Int // portion to collect via M-Pesa STK
  status        String    @default("awaiting_payment") // awaiting_payment | confirmed | boarded | cancelled | completed | no_show
  cancelTier    String? // early | late | platform_cancelled | no_show
  cancellationRequestedAt DateTime? // first passenger request time; support processes the cancellation
  cancelledAt   DateTime?
  checkedInAt   DateTime?
  boardedSeats  Int       @default(0)
  noShowSeats   Int       @default(0)
  noShowReason  String?
  allocationNote String?
  // Guest checkout (Tahmeed-style): who is travelling, captured at booking
  // time with no account needed. Phone doubles as the default M-Pesa number.
  passengerName  String?
  passengerPhone String? // normalized 2547XXXXXXXX
  // Per-booking snapshot of the primary passenger's details (what the driver's
  // manifest shows) — stays frozen even if the profile is edited later.
  passengerEmail       String?
  passengerIdType      String?
  passengerIdNumber    String? // AES-256-GCM encrypted ID/passport snapshot; legacy plaintext until backfill
  passengerNationality String?
  passengerGender      String?
  ledgerEntry   LedgerEntry?
  ticketEmailDelivery BookingTicketEmailDelivery?
  refunds       RefundRecord[]
  mpesaTransactions MpesaTransaction[]
  createdAt     DateTime  @default(now())
  @@index([status, createdAt])
}

// Durable delivery state for the customer ticket. A unique row per booking
// prevents duplicate webhook callbacks from sending duplicate tickets.
model BookingTicketEmailDelivery {
  id                String   @id @default(cuid())
  bookingId         String   @unique
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status            String   @default("pending") // pending | sending | sent | failed | blocked | uncertain
  attempts          Int      @default(0)
  providerMessageId String?
  lastErrorCode     String?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([status, updatedAt])
}

// ─── Money (the ledger) ──────────────────────────────────────────────────────

// One row per booking's payment. Every shilling sits in exactly one bucket.
model LedgerEntry {
  id                  String   @id @default(cuid())
  bookingId           String   @unique
  booking             Booking  @relation(fields: [bookingId], references: [id])
  tripId              String?
  totalAmount         Int // full fare value (cash + credit portions)
  cashAmount          Int // actually collected via STK push
  creditApplied       Int // portion paid with travel credit
  homeSurchargeAmount Int // tracked separately — passes to driver in full
  platformFeeAmount   Int      @default(0) // shared: per-seat Mireli fee total; charter: one fee included within the 10% share
  mpesaReceipt        String?
  collectedAt         DateTime?
  status              String   @default("held") // held | driver_payable | commission_taken | refunded | partially_refunded | converted_to_credit | partially_converted_to_credit | forfeited
  statusChangedAt     DateTime @default(now())
  createdAt           DateTime @default(now())
  refunds             RefundRecord[]
}

model RefundRecord {
  id                 String   @id @default(cuid())
  ledgerEntryId      String
  ledgerEntry        LedgerEntry @relation(fields: [ledgerEntryId], references: [id])
  bookingId          String
  booking            Booking  @relation(fields: [bookingId], references: [id])
  amount             Int // cash returned to passenger
  creditRestored     Int      @default(0) // credit portion restored as travel credit (info)
  commissionReversed Int      @default(0) // charter platform share (commission plus embedded fee) reversed
  driverClawback     Int      @default(0) // driver share to recover (from future payout)
  reason             String // cancelled_early | cancelled_late | no_show_partial | admin_override | platform_cancelled
  method             String // reversal | b2c
  mpesaResultCode    String?
  status             String   @default("pending") // pending | completed | failed
  stuckFlaggedAt     DateTime?
  failureReason      String?
  initiatedAt        DateTime @default(now())
  completedAt        DateTime?
  attempts           RefundAttempt[]
}

// Every provider refund is correlated to a private callback capability before
// submission. An accepted HTTP response is pending, never proof of settlement.
model RefundAttempt {
  id                String   @id @default(cuid())
  refundId          String
  refund            RefundRecord @relation(fields: [refundId], references: [id], onDelete: Restrict)
  callbackHash      String   @unique
  method            String // reversal | b2c
  amount            Int
  receiverPhone     String?
  originalReceipt   String?
  state             String   @default("submitting") // submitting | processing | ambiguous | confirmed | failed
  conversationId    String?  @unique
  originatorId      String?  @unique
  receipt           String?  @unique
  resultCode        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([refundId, state])
}

model PayoutRecord {
  id                  String    @id @default(cuid())
  driverId            String
  driver              Driver    @relation(fields: [driverId], references: [id])
  tripId              String?
  trip                Trip?     @relation(fields: [tripId], references: [id])
  grossFareTotal      Int // customer total before separately itemized platform fee and commission
  commissionAmount    Int // charter percentage share minus its separately recorded embedded booking fee
  homeSurchargeAmount Int // passes through in full — not part of commission base
  platformFeeAmount   Int      @default(0) // separate platform take; deducted from gross before driver net
  netPayoutAmount     Int
  method              String    @default("b2c")
  mpesaResultCode     String?
  status              String    @default("queued") // queued | completed | failed
  failureReason       String?
  batchId             String?
  initiatedAt         DateTime  @default(now())
  completedAt         DateTime?
  ledgerEntryId       String?   @unique
  settlementVerified Boolean @default(false)
  attempts            PayoutAttempt[]
}

model DriverSession {
  id String @id @default(cuid())
  driverId String
  driver Driver @relation(fields: [driverId], references: [id])
  tokenHash String @unique
  deviceId String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([driverId, expiresAt])
}

model DriverTripProgress {
  id String @id @default(cuid())
  tripId String
  trip Trip @relation(fields: [tripId], references: [id])
  driverId String
  driver Driver @relation(fields: [driverId], references: [id])
  phase String @default("assigned")
  version Int @default(0)
  acceptedAt DateTime?
  arrivedAt DateTime?
  declineReason String?
  updatedAt DateTime @updatedAt
  @@unique([tripId, driverId])
}

model DriverTripAction {
  id String @id @default(cuid())
  driverId String
  driver Driver @relation(fields: [driverId], references: [id])
  clientActionId String
  tripId String
  requestHash String
  result String
  createdAt DateTime @default(now())
  @@unique([driverId, clientActionId])
}

model DriverSupportCase {
  id String @id @default(cuid())
  driverId String
  driver Driver @relation(fields: [driverId], references: [id])
  clientActionId String
  category String
  message String
  status String @default("open")
  reply String?
  version Int @default(0)
  assignedTo String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([driverId,clientActionId])
  @@index([driverId,createdAt])
}

model DriverPayoutDestination {
  id String @id @default(cuid())
  driverId String @unique
  driver Driver @relation(fields: [driverId], references: [id])
  phone String
  accountName String
  status String @default("pending_review")
  version Int @default(0)
  acknowledgedAt DateTime
  reviewedAt DateTime?
  reviewedBy String?
  reviewNote String?
  updatedAt DateTime @updatedAt
}

model DriverAuthChallenge {
  id String @id @default(cuid())
  phone String?
  email String?
  channel String @default("sms")
  codeHash String
  expiresAt DateTime
  consumedAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
  @@index([email, createdAt])
}

model DriverRateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
}

model DriverApplication {
  id String @id @default(cuid())
  driverId String @unique
  driver Driver @relation(fields: [driverId], references: [id])
  status String @default("draft")
  version Int @default(0)
  licenceClass String @default("")
  ownsVehicle Boolean @default(true)
  policyVersion String?
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewedBy String?
  reviewReason String?
  documents DriverDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DriverDocument {
  id String @id @default(cuid())
  applicationId String
  application DriverApplication @relation(fields: [applicationId], references: [id])
  type String
  objectKey String @unique
  mime String
  bytes Int
  sha256 String
  expiresAt DateTime?
  state String @default("pending_review")
  scanState String @default("pending")
  reviewedBy String?
  reviewedAt DateTime?
  reviewReason String?
  createdAt DateTime @default(now())
  @@index([applicationId, type, state])
}

model PayoutAttempt {
  id String @id @default(cuid())
  payoutId String
  payout PayoutRecord @relation(fields: [payoutId], references: [id])
  callbackHash String @unique
  receiverPhone String
  amount Int
  state String @default("submitting")
  conversationId String? @unique
  originatorId String?
  receipt String? @unique
  resultCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([payoutId, state])
}

// Travel voucher — issued on late cancellation, never cashed out
model Credit {
  id                String    @id @default(cuid())
  passengerId       String
  passenger         Passenger @relation(fields: [passengerId], references: [id])
  sourceBookingId   String?
  amount            Int // remaining redeemable amount
  initialAmount     Int
  status            String    @default("active") // active | redeemed | expired
  note              String?
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime
  redeemedAt        DateTime?
  redeemedBookingId String?
}

// Simulated Daraja STK-push collection attempts (Transaction Status sweep target)
model MpesaTransaction {
  id                String    @id @default(cuid())
  bookingId         String
  booking           Booking   @relation(fields: [bookingId], references: [id])
  phone             String
  amount            Int
  checkoutRequestId String    @unique
  merchantRequestId String
  mpesaReceipt      String?
  status            String    @default("stk_push_sent") // pending | stk_push_sent | confirmed | failed | ambiguous
  resultCode        String?
  resultDesc        String?
  createdAt         DateTime  @default(now())
  confirmedAt       DateTime?
}

// ─── Platform configuration & ops state ─────────────────────────────────────

model PlatformConfig {
  id                         String    @id @default("main")
  commissionRate             Float     @default(0.10) // charter commission; must stay under NTSA 18% cap
  bookingFeeAmount           Int       @default(50) // KSh Mireli fee per shared passenger seat; one fee is included in a charter's 10% share
  fullRefundCutoffMinutes    Int       @default(1440) // 24 hours before scheduled pickup
  seatFillThresholdPercent   Int       @default(70) // trip locks early when this full
  creditValidityDays         Int       @default(30) // late-cancellation credit validity
  payoutMode                 String    @default("instant_per_trip") // after each completed trip
  payoutDay                  Int       @default(5) // 0=Sun .. 5=Fri (weekly batch day)
  stuckRefundHours           Int       @default(4) // pending refund alert threshold
  stuckPayoutHours           Int       @default(24) // queued payout alert threshold
  sweepPendingMinutes        Int       @default(5) // STK ambiguity → Transaction Status sweep
  unpaidBookingHoldMinutes   Int       @default(15) // unpaid reservation expiry after checkout is abandoned
  tripHorizonDays            Int       @default(2)
  bookingWindowMinutes       Int       @default(15) // min minutes before departure to book
  terminusArrivalBufferMinutes Int     @default(60) // TO_TERMINUS cabs reach MTM this early before train departure
  trainMeetBufferMinutes     Int       @default(45) // FROM_TERMINUS cabs leave MTM this long after train arrival
  // ─── M-Pesa Daraja credentials ────────────────────────────────────────────
  // Environment variables with the same names take precedence when present.
  // Until consumer key + secret + shortcode + passkey exist (env or here),
  // every Daraja call runs the deterministic demo simulator.
  mpesaEnvironment           String    @default("sandbox") // sandbox | production
  mpesaConsumerKey           String    @default("")
  mpesaConsumerSecret        String    @default("")
  mpesaShortcode             String    @default("") // collection shortcode — fares land here (also shown as Paybill)
  mpesaPasskey               String    @default("") // Lipa na M-Pesa Online passkey
  mpesaCallbackBaseUrl       String    @default("") // public https base for Daraja callbacks, e.g. https://mireli.co.ke
  mpesaB2CShortcode          String    @default("") // initiator shortcode for B2C/refunds (blank = collection shortcode)
  mpesaInitiatorName         String    @default("") // API operator for B2C / Reversal
  mpesaInitiatorPassword     String    @default("") // encrypted with the Safaricom cert at call time
  mpesaSecurityCredential    String    @default("") // OR paste a pre-encrypted security credential
  mpesaCert                  String    @default("") // Safaricom public certificate (PEM)
  mpesaLastTestAt            DateTime?
  mpesaLastTestOk            Boolean?
  mpesaLastTestMessage       String    @default("")
  adminEmails                String    @default("[\"demitri@mireli.co.ke\",\"admin@mireli.co.ke\"]")
  admin2faCode               String    @default("mireli2026")
  lastPayoutRunAt            DateTime?
  lastReconciliationAt       DateTime?
  updatedAt                  DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  actorRole String // passenger | admin | system
  action    String // e.g. booking.create, payment.confirm, booking.cancel_early, payout.batch_run
  entity    String
  entityId  String
  metadata  String? // JSON
  createdAt DateTime @default(now())
}
